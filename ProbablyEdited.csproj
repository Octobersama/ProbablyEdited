<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ProbablyEdited</AssemblyName>
    <RootNamespace>ProbablyEdited</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>OctoberSama</Authors>
    <Copyright>Copyright 2026 OctoberSama</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GameDirectory Condition="'$(GameDirectory)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Probably Stolen</GameDirectory>
    <GameManaged>$(GameDirectory)\Probably Stolen_Data\Managed</GameManaged>
    <OutputPath>build\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManaged)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameManaged)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameManaged)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameManaged)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManaged)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.Localization" HintPath="$(GameManaged)\Unity.Localization.dll" Private="false" />
    <Reference Include="Unity.ResourceManager" HintPath="$(GameManaged)\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="Unity.Addressables" HintPath="$(GameManaged)\Unity.Addressables.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameManaged)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameManaged)\0Harmony.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <ModLocalization Include="Localization\*.csv" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManaged)\Assembly-CSharp.dll')" Text="找不到游戏程序集。使用 -p:GameDirectory=&quot;游戏安装目录&quot; 指定 Probably Stolen 安装位置。" />
  </Target>
  <Target Name="PackageMod" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\dist\ProbablyEdited" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\manifest.xml;$(MSBuildProjectDirectory)\LICENSE;$(MSBuildProjectDirectory)\NOTICE" DestinationFolder="$(MSBuildProjectDirectory)\dist\ProbablyEdited" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\dist\ProbablyEdited\Localization" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\dist\ProbablyEdited\Localization" />
    <Copy SourceFiles="@(ModLocalization)" DestinationFolder="$(MSBuildProjectDirectory)\dist\ProbablyEdited\Localization" />
  </Target>
</Project>
